{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-server",
    "rootDir": "src",
    "types": ["node"],
    "sourceMap": true
  },
  "include": ["src/backend/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-server"]
}
